{
  "name": "harness",
  "version": "0.1.0",
  "description": "An autonomous agent organisation (chief of staff, leads, sub-agents) with a single prioritised human review queue and a principal brain.",
  "type": "module",
  "private": true,
  "engines": { "node": ">=22.13" },
  "bin": { "harness": "./bin/harness.js" },
  "scripts": {
    "start": "node --no-warnings=ExperimentalWarning --import tsx src/index.ts start",
    "harness": "node --no-warnings=ExperimentalWarning --import tsx src/index.ts",
    "dev": "node --no-warnings=ExperimentalWarning --import tsx --watch src/index.ts start",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --no-warnings=ExperimentalWarning --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.319",
    "marked": "^15.0.12",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
