# One of the two is required for the agents to run.
# 1) An API key from https://platform.claude.com
ANTHROPIC_API_KEY=
# 2) Or a Claude subscription token: run `claude setup-token` and paste the result here.
# CLAUDE_CODE_OAUTH_TOKEN=

# Optional: override the port of the queue web app (default 4242)
# HARNESS_PORT=4242
